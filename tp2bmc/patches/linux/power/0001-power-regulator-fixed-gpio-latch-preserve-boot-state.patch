From 8939887cb707e233937a091f65f23f1e6d1a23ea Mon Sep 17 00:00:00 2001
From: Sven Rademakers <sven@turingpi.com>
Date: Sat, 9 May 2026 13:35:09 +0200
Subject: [PATCH] power: regulator-fixed + gpio-latch preserve boot state

Two coupled changes to keep node-power rails alive across warm reboot
on the Turing Pi 2 cluster board:

1. regulator-fixed: add the "preserve-boot-state" DT property. When set,
   the enable GPIO is requested with GPIOD_ASIS instead of being driven
   from enabled_at_boot, so the regulator core leaves the bootloader-
   programmed state untouched until something explicitly toggles the
   regulator.

2. gpio-latch: persist the latch shadow across warm reboot by mirroring
   it into the SoC's SRAM A2 scratchpad at 0x0709010c (a single u32),
   shared with the U-Boot SPL boot cookie at 0x07090108. The shadow is
   accessed via devm_ioremap()/ioread32()/iowrite32(); on cold boot the
   SPL zeros bits 0..8 ("TPi2" cookie absent), on warm boot the kernel
   re-reads the previous instance's state.

   Adds a .get callback so userspace tools (gpioget, bmcd) can query
   the latched state. Direction-input/output ops are intentionally
   omitted: every consumer in the firmware stack (SPL, kernel and
   bmcd v2.3.4) only ever drives these lines as outputs.

Trimmed compared to the v6.8.12-era out-of-tree patch (~80 LoC of fake
direction tracking, manual ioremap/iounmap, and memcpy_fromio/toio of a
heap bitmap removed). devm_ioremap() obviates a separate .remove
callback. The shadow contract with the SPL is documented inline so the
0x0709010c hard-code is not load-bearing on tribal knowledge.

Signed-off-by: Sven Rademakers <sven@turingpi.com>
Signed-off-by: Turing Pi 2 BMC <bmc@turingpi.local>
---
 drivers/gpio/gpio-latch.c       | 68 ++++++++++++++++++++++++++++++---
 drivers/regulator/fixed.c       | 17 +++++++--
 include/linux/regulator/fixed.h |  5 +++
 3 files changed, 82 insertions(+), 8 deletions(-)

diff --git a/drivers/gpio/gpio-latch.c b/drivers/gpio/gpio-latch.c
index c64aaa896766..cac299b9a75a 100644
--- a/drivers/gpio/gpio-latch.c
+++ b/drivers/gpio/gpio-latch.c
@@ -42,6 +42,7 @@
 #include <linux/err.h>
 #include <linux/gpio/consumer.h>
 #include <linux/gpio/driver.h>
+#include <linux/io.h>
 #include <linux/module.h>
 #include <linux/mod_devicetable.h>
 #include <linux/platform_device.h>
@@ -50,6 +51,31 @@
 
 #include "gpiolib.h"
 
+/*
+ * Turing Pi 2 SPL/kernel contract for the latch shadow word:
+ *
+ *   On the Allwinner T113s SoC, the SPL (turing-machines/u-boot,
+ *   board/turing/pi2/turingpi2-spl.c) reserves two 32-bit words in
+ *   SRAM A2 / scratchpad:
+ *
+ *     0x07090108 : boot cookie ("TPi2" = 0x32695054)
+ *     0x0709010c : latched-state shadow (bits 0..8 = 9 latched lines)
+ *
+ *   The cookie is what tells SPL whether the current boot is cold
+ *   (cookie absent) or warm (cookie matches "TPi2"). On cold boot the
+ *   SPL drives every latched line low and zeros bits 0..8 of the
+ *   shadow word; on warm boot the shadow is left intact so the kernel
+ *   can faithfully report the state set by the previous instance.
+ *
+ *   This region is not nvmem (no NV backing, no RTC retention) — it
+ *   is plain mmio-sram. The bare ioremap below is intentional and
+ *   load-bearing for the cooperative SPL/kernel contract above.
+ *
+ *   Bumping this address requires a matching change in the SPL.
+ */
+#define TURING_PI2_LATCH_STATE_ADDR	0x0709010cUL
+#define TURING_PI2_LATCH_STATE_SIZE	sizeof(u32)
+
 struct gpio_latch_priv {
 	struct gpio_chip gc;
 	struct gpio_descs *clk_gpios;
@@ -57,7 +83,7 @@ struct gpio_latch_priv {
 	int n_latched_gpios;
 	unsigned int setup_duration_ns;
 	unsigned int clock_duration_ns;
-	unsigned long *shadow;
+	void __iomem *shadow;
 	/*
 	 * Depending on whether any of the underlying GPIOs may sleep we either
 	 * use a mutex or a spinlock to protect our shadow map.
@@ -68,6 +94,16 @@ struct gpio_latch_priv {
 	};
 };
 
+static u32 gpio_latch_shadow_read(struct gpio_latch_priv *priv)
+{
+	return ioread32(priv->shadow);
+}
+
+static void gpio_latch_shadow_write(struct gpio_latch_priv *priv, u32 val)
+{
+	iowrite32(val, priv->shadow);
+}
+
 static int gpio_latch_get_direction(struct gpio_chip *gc, unsigned int offset)
 {
 	return GPIO_LINE_DIRECTION_OUT;
@@ -78,13 +114,14 @@ static int gpio_latch_set_unlocked(struct gpio_latch_priv *priv,
 				   unsigned int offset, bool val)
 {
 	int latch = offset / priv->n_latched_gpios, i, ret;
+	unsigned long shadow = gpio_latch_shadow_read(priv);
 
-	assign_bit(offset, priv->shadow, val);
+	assign_bit(offset, &shadow, val);
 
 	for (i = 0; i < priv->n_latched_gpios; i++) {
 		ret = set(priv->latched_gpios->desc[i],
 			  test_bit(latch * priv->n_latched_gpios + i,
-				   priv->shadow));
+				   &shadow));
 		if (ret)
 			return ret;
 	}
@@ -94,9 +131,24 @@ static int gpio_latch_set_unlocked(struct gpio_latch_priv *priv,
 	ndelay(priv->clock_duration_ns);
 	set(priv->clk_gpios->desc[latch], 0);
 
+	gpio_latch_shadow_write(priv, shadow);
+
 	return 0;
 }
 
+static int gpio_latch_get(struct gpio_chip *gc, unsigned int offset)
+{
+	struct gpio_latch_priv *priv = gpiochip_get_data(gc);
+
+	if (gc->can_sleep) {
+		guard(mutex)(&priv->mutex);
+		return !!(gpio_latch_shadow_read(priv) & BIT(offset));
+	}
+
+	guard(spinlock_irqsave)(&priv->spinlock);
+	return !!(gpio_latch_shadow_read(priv) & BIT(offset));
+}
+
 static int gpio_latch_set(struct gpio_chip *gc, unsigned int offset, int val)
 {
 	struct gpio_latch_priv *priv = gpiochip_get_data(gc);
@@ -159,8 +211,13 @@ static int gpio_latch_probe(struct platform_device *pdev)
 	n_latches = priv->clk_gpios->ndescs;
 	priv->n_latched_gpios = priv->latched_gpios->ndescs;
 
-	priv->shadow = devm_bitmap_zalloc(dev, n_latches * priv->n_latched_gpios,
-					  GFP_KERNEL);
+	if (n_latches * priv->n_latched_gpios > BITS_PER_TYPE(u32))
+		return dev_err_probe(dev, -EINVAL,
+				     "shadow word too small for %u latched lines\n",
+				     n_latches * priv->n_latched_gpios);
+
+	priv->shadow = devm_ioremap(dev, TURING_PI2_LATCH_STATE_ADDR,
+				    TURING_PI2_LATCH_STATE_SIZE);
 	if (!priv->shadow)
 		return -ENOMEM;
 
@@ -191,6 +248,7 @@ static int gpio_latch_probe(struct platform_device *pdev)
 	}
 
 	priv->gc.get_direction = gpio_latch_get_direction;
+	priv->gc.get = gpio_latch_get;
 	priv->gc.ngpio = n_latches * priv->n_latched_gpios;
 	priv->gc.owner = THIS_MODULE;
 	priv->gc.base = -1;
diff --git a/drivers/regulator/fixed.c b/drivers/regulator/fixed.c
index 254c0a8a4555..2b7c07083556 100644
--- a/drivers/regulator/fixed.c
+++ b/drivers/regulator/fixed.c
@@ -198,6 +198,9 @@ of_get_fixed_voltage_config(struct device *dev,
 	of_property_read_u32(np, "startup-delay-us", &config->startup_delay);
 	of_property_read_u32(np, "off-on-delay-us", &config->off_on_delay);
 
+	if (of_property_present(np, "preserve-boot-state"))
+		config->preserve_boot_state = 1;
+
 	if (of_property_present(np, "vin-supply"))
 		config->input_supply = "vin";
 
@@ -293,10 +296,18 @@ static int reg_fixed_voltage_probe(struct platform_device *pdev)
 	drvdata->desc.fixed_uV = config->microvolts;
 
 	/*
-	 * The signal will be inverted by the GPIO core if flagged so in the
-	 * descriptor.
+	 * If preserve-boot-state is set, the bootloader (or a previous
+	 * kernel instance) is responsible for the GPIO state and we must
+	 * not clobber it at probe time. Request the descriptor with
+	 * GPIOD_ASIS so the regulator core leaves the pin alone until
+	 * something explicitly enables/disables the regulator.
+	 *
+	 * Otherwise the signal will be inverted by the GPIO core if
+	 * flagged so in the descriptor.
 	 */
-	if (config->enabled_at_boot)
+	if (config->preserve_boot_state)
+		gflags = GPIOD_ASIS;
+	else if (config->enabled_at_boot)
 		gflags = GPIOD_OUT_HIGH;
 	else
 		gflags = GPIOD_OUT_LOW;
diff --git a/include/linux/regulator/fixed.h b/include/linux/regulator/fixed.h
index 55319943fcc5..2f1784ac656c 100644
--- a/include/linux/regulator/fixed.h
+++ b/include/linux/regulator/fixed.h
@@ -25,6 +25,10 @@ struct regulator_init_data;
  * 			boot or not. 1 = Yes, 0 = No
  * 			This is used to keep the regulator at
  * 			the default state
+ * @preserve_boot_state:	Whether to leave the enable-GPIO untouched at
+ * 			probe time (request as GPIOD_ASIS) instead of
+ * 			driving it from @enabled_at_boot. Used together
+ * 			with the "preserve-boot-state" DT property.
  * @init_data:		regulator_init_data
  *
  * This structure contains fixed voltage regulator configuration
@@ -38,6 +42,7 @@ struct fixed_voltage_config {
 	unsigned startup_delay;
 	unsigned int off_on_delay;
 	unsigned enabled_at_boot:1;
+	unsigned preserve_boot_state:1;
 	struct regulator_init_data *init_data;
 };
 
-- 
