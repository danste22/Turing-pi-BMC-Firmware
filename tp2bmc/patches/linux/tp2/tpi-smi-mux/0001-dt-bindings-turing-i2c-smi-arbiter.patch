From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Sven Rademakers <sven@turingpi.com>
Date: Mon, 02 Jun 2026 12:00:00 +0200
Subject: [PATCH 1/3] dt-bindings: i2c: add turing,i2c-smi-arbiter

Document the arbiter that serializes HW I2C (Profile A) and GPIO SMI
bitbang (Profile B) on shared TWI pins for Turing Pi 2.

Also document the consumer property "turing,smi-arbiter" used by the
Realtek SMI driver to obtain the arbiter phandle.

Signed-off-by: Sven Rademakers <sven@turingpi.com>
---
 .../devicetree/bindings/i2c/turing,i2c-smi-arbiter.yaml | 74 ++++++++++++++++++++++++
 1 file changed, 74 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/i2c/turing,i2c-smi-arbiter.yaml

diff --git a/Documentation/devicetree/bindings/i2c/turing,i2c-smi-arbiter.yaml b/Documentation/devicetree/bindings/i2c/turing,i2c-smi-arbiter.yaml
new file mode 100644
index 000000000000..a1b2c3d4e5f6
--- /dev/null
+++ b/Documentation/devicetree/bindings/i2c/turing,i2c-smi-arbiter.yaml
@@ -0,0 +1,74 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/i2c/turing,i2c-smi-arbiter.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Turing Pi 2 I2C / SMI pin profile arbiter
+
+maintainers:
+  - Sven Rademakers <sven@turingpi.com>
+
+description: |
+  Serializes access to a shared two-wire bus where Profile A uses the SoC
+  hardware I2C controller (pinctrl "default") and Profile B uses GPIO SMI
+  bitbang (pinctrl "smi_mode") on the same pins.
+
+  The I2C controller node must define pinctrl-names = "default", "smi_mode"
+  so the arbiter can switch pin ownership between the TWI block and gpiolib.
+
+  Consumers reference this node via a "turing,smi-arbiter" phandle property
+  on their own DT node.  The realtek-smi driver uses this to bracket every
+  SMI register access with tpi_smi_arb_begin() / tpi_smi_arb_end().
+
+properties:
+  compatible:
+    const: turing,i2c-smi-arbiter
+
+  i2c-bus:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: Phandle to the shared I2C controller (e.g. &i2c2).
+
+required:
+  - compatible
+  - i2c-bus
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    /* I2C controller with two pinctrl states for shared-pin arbitration */
+    i2c2: i2c@2502800 {
+        compatible = "allwinner,sun8i-v536-i2c", "allwinner,sun6i-a31-i2c";
+        reg = <0x02502800 0x400>;
+        #address-cells = <1>;
+        #size-cells = <0>;
+        status = "okay";
+
+        pinctrl-names = "default", "smi_mode";
+        pinctrl-0 = <&i2c2_pe_pins>;
+        pinctrl-1 = <&i2c2_smi_pins>;
+    };
+
+    /* Arbiter that serializes HW I2C vs GPIO SMI on PE12/PE13 */
+    tpi_i2c_smi_arb: tpi-i2c-smi-arb {
+        compatible = "turing,i2c-smi-arbiter";
+        i2c-bus = <&i2c2>;
+    };
+
+    /* Realtek SMI switch referencing the arbiter */
+    switch@smi {
+        compatible = "realtek,rtl8365mb";
+        turing,smi-arbiter = <&tpi_i2c_smi_arb>;
+
+        mdc-gpios = <&pio 4 12 GPIO_ACTIVE_HIGH>;
+        mdio-gpios = <&pio 4 13 GPIO_ACTIVE_HIGH>;
+        reset-gpios = <&pio 4 14 GPIO_ACTIVE_LOW>;
+
+        ethernet-ports {
+            #address-cells = <1>;
+            #size-cells = <0>;
+        };
+    };
+
-- 
