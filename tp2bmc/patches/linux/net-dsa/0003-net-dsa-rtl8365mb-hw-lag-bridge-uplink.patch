+		dsa_default_offload_fwd_mark(skb);
+		/* When a hardware LAG is active, clear offload_fwd_mark
+		 * only for broadcast/multicast from non-LAG ports so the
+		 * software bridge can flood ARP/DHCP to bond0 (same hwdom
+		 * would otherwise block that egress).
