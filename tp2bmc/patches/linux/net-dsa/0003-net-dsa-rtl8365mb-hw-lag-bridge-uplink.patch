diff --git a/drivers/net/dsa/realtek/rtl8365mb_lag.c b/drivers/net/dsa/realtek/rtl8365mb_lag.c
new file mode 100644
index 000000000000..a1b2c3d4e5f6
--- /dev/null
+++ b/drivers/net/dsa/realtek/rtl8365mb_lag.c
@@ -0,0 +1,628 @@
+// SPDX-License-Identifier: GPL-2.0
+/* Hardware LAG / trunk offload for rtl8365mb-class switches (RTL8367C ASIC API)
+ *
+ * Port trunk register map from Realtek rtl8367c vendor driver, validated for
+ * RTL8370MB-CG (chip_id 0x6368) on Turing Pi 2.
+ */
+
+#include "rtl8365mb_lag.h"
+#include "realtek.h"
+
+#include <linux/bitops.h>
+#include <linux/if_bridge.h>
+#include <linux/mii.h>
+#include <linux/netdevice.h>
+#include <linux/regmap.h>
+
+/* Trunk control (0x08cf) */
+#define RTL8365MB_REG_PORT_TRUNK_CTRL			0x08cf
+#define   RTL8365MB_PORT_TRUNK_HASH_MASK			GENMASK(6, 0)
+#define   RTL8365MB_PORT_TRUNK_FLOOD_MASK			BIT(7)
+#define   RTL8365MB_PORT_TRUNK_DUMB_MASK			BIT(8)
+#define   RTL8365MB_PORT_TRUNK_HASH_SPA			BIT(0)
+#define   RTL8365MB_PORT_TRUNK_HASH_SMAC			BIT(1)
+#define   RTL8365MB_PORT_TRUNK_HASH_DMAC			BIT(2)
+#define   RTL8365MB_PORT_TRUNK_HASH_SIP			BIT(3)
+#define   RTL8365MB_PORT_TRUNK_HASH_DIP			BIT(4)
+#define   RTL8365MB_PORT_TRUNK_HASH_SPORT			BIT(5)
+#define   RTL8365MB_PORT_TRUNK_HASH_DPORT			BIT(6)
+
+#define RTL8365MB_REG_PORT_TRUNK_GROUP_MASK		0x08d0
+#define   RTL8365MB_TRUNK_GROUP_FIELD_MASK		GENMASK(3, 0)
+
+#define RTL8365MB_REG_TRUNK_HASH_MAP_G0_LO		0x08d2
+#define RTL8365MB_REG_TRUNK_HASH_MAP_G0_HI		0x08d3
+#define RTL8365MB_REG_TRUNK_HASH_MAP_G1_LO		0x08a0
+#define RTL8365MB_REG_TRUNK_HASH_MAP_G1_HI		0x08a1
+
+/* Only groups 0 and 1 have hash map registers. */
+#define RTL8365MB_MAX_TRUNK_GID				1
+#define RTL8365MB_TRUNK_GROUP_PORTS			4
+#define RTL8365MB_TRUNK_HASH_BUCKETS			16
+
+struct rtl8365mb_lag_ctx {
+	struct mutex *lock;
+	u32 *hash_sel;
+};
+
+static int rtl8365mb_trunk_group_field(int group, u32 *mask, u32 *shift)
+{
+	if (group < 0 || group > RTL8365MB_MAX_TRUNK_GID)
+		return -EINVAL;
+
+	*shift = group * RTL8365MB_TRUNK_GROUP_PORTS;
+	*mask = RTL8365MB_TRUNK_GROUP_FIELD_MASK << *shift;
+	return 0;
+}
+
+static int rtl8365mb_trunk_set_group_local(struct realtek_priv *priv, int group,
+					   u32 local_mask)
+{
+	u32 field_mask, shift;
+	int ret;
+
+	ret = rtl8365mb_trunk_group_field(group, &field_mask, &shift);
+	if (ret)
+		return ret;
+
+	return regmap_update_bits(priv->map, RTL8365MB_REG_PORT_TRUNK_GROUP_MASK,
+				  field_mask, (local_mask << shift) & field_mask);
+}
+
+static int rtl8365mb_trunk_set_mode(struct realtek_priv *priv, bool dumb)
+{
+	return regmap_update_bits(priv->map, RTL8365MB_REG_PORT_TRUNK_CTRL,
+				  RTL8365MB_PORT_TRUNK_DUMB_MASK,
+				  dumb ? RTL8365MB_PORT_TRUNK_DUMB_MASK : 0);
+}
+
+static int rtl8365mb_trunk_set_flood(struct realtek_priv *priv, bool enable)
+{
+	return regmap_update_bits(priv->map, RTL8365MB_REG_PORT_TRUNK_CTRL,
+				  RTL8365MB_PORT_TRUNK_FLOOD_MASK,
+				  enable ? RTL8365MB_PORT_TRUNK_FLOOD_MASK : 0);
+}
+
+static int rtl8365mb_trunk_set_hash_sel(struct realtek_priv *priv, u32 hash_sel)
+{
+	return regmap_update_bits(priv->map, RTL8365MB_REG_PORT_TRUNK_CTRL,
+				  RTL8365MB_PORT_TRUNK_HASH_MASK, hash_sel);
+}
+
+static void rtl8365mb_trunk_hash_regs(int group, u32 hashval,
+				      u32 *reg, u32 *shift, u32 *mask)
+{
+	if (group == 0) {
+		if (hashval >= 8) {
+			*reg = RTL8365MB_REG_TRUNK_HASH_MAP_G0_HI;
+			hashval -= 8;
+		} else {
+			*reg = RTL8365MB_REG_TRUNK_HASH_MAP_G0_LO;
+		}
+	} else {
+		if (hashval >= 8) {
+			*reg = RTL8365MB_REG_TRUNK_HASH_MAP_G1_HI;
+			hashval -= 8;
+		} else {
+			*reg = RTL8365MB_REG_TRUNK_HASH_MAP_G1_LO;
+		}
+	}
+
+	*shift = hashval * 2;
+	*mask = GENMASK(*shift + 1, *shift);
+}
+
+static int rtl8365mb_trunk_hash_map_set(struct realtek_priv *priv, int group,
+					u32 hashval, u32 member_id)
+{
+	u32 reg, shift, mask;
+
+	if (hashval >= RTL8365MB_TRUNK_HASH_BUCKETS ||
+	    member_id >= RTL8365MB_TRUNK_GROUP_PORTS)
+		return -EINVAL;
+
+	if (group > RTL8365MB_MAX_TRUNK_GID)
+		return -EOPNOTSUPP;
+
+	rtl8365mb_trunk_hash_regs(group, hashval, &reg, &shift, &mask);
+	return regmap_update_bits(priv->map, reg, mask,
+				  member_id << shift);
+}
+
+static int rtl8365mb_trunk_program_hash_table(struct realtek_priv *priv,
+					    int group, u8 *members, int nmembers)
+{
+	int h, ret;
+
+	for (h = 0; h < RTL8365MB_TRUNK_HASH_BUCKETS; h++) {
+		u8 member = members[(h * nmembers) / RTL8365MB_TRUNK_HASH_BUCKETS];
+
+		ret = rtl8365mb_trunk_hash_map_set(priv, group, h, member);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
+
+static int rtl8365mb_lag_group_for_pmask(u32 pmask, int *group)
+{
+	int g;
+
+	for (g = 0; g <= RTL8365MB_MAX_TRUNK_GID; g++) {
+		u32 field_mask = RTL8365MB_TRUNK_GROUP_FIELD_MASK <<
+				 (g * RTL8365MB_TRUNK_GROUP_PORTS);
+
+		if (pmask && !(pmask & ~field_mask)) {
+			*group = g;
+			return 0;
+		}
+	}
+
+	return -EINVAL;
+}
+
+static int rtl8365mb_lag_member_pmask(struct dsa_switch *ds, struct dsa_lag lag,
+				      u32 *pmask)
+{
+	struct dsa_port *dp;
+
+	*pmask = 0;
+	dsa_lag_foreach_port(dp, ds->dst, &lag) {
+		if (dp->ds != ds)
+			continue;
+		if (!dsa_is_user_port(ds, dp->index))
+			return -EOPNOTSUPP;
+		*pmask |= BIT(dp->index);
+	}
+
+	return *pmask ? 0 : -EINVAL;
+}
+
+/* bond0 on br0 is not a DSA port; restore ASIC reachability node* <-> ge0/ge1. */
+static u32 rtl8365mb_lag_br_efid(struct dsa_switch *ds, u32 node_pmask, int port_hint)
+{
+	struct dsa_port *dp;
+	u16 efid = 0;
+
+	if (port_hint >= 0) {
+		dp = dsa_to_port(ds, port_hint);
+		if (dsa_port_bridge_dev_get(dp)) {
+			efid = dsa_port_bridge_num_get(dp);
+			if (efid)
+				return efid;
+		}
+	}
+
+	dsa_switch_for_each_user_port(dp, ds) {
+		if (!(node_pmask & BIT(dp->index)))
+			continue;
+		if (!dsa_port_bridge_dev_get(dp))
+			continue;
+		efid = dsa_port_bridge_num_get(dp);
+		if (efid)
+			break;
+	}
+
+	return efid;
+}
+
+static void rtl8365mb_lag_bridge_isolation_fixup(struct dsa_switch *ds, u32 lag_pmask,
+						 int port_hint)
+{
+	struct realtek_priv *priv = ds->priv;
+	struct dsa_port *dp;
+	u32 node_pmask = 0;
+	u32 cpu_pmask = 0;
+	u32 br_efid;
+
+	if (!lag_pmask || hweight32(lag_pmask) < 2)
+		return;
+
+	if (!priv->ops->port_add_isolation)
+		return;
+
+	dsa_switch_for_each_cpu_port(dp, ds)
+		cpu_pmask |= BIT(dp->index);
+
+	dsa_switch_for_each_user_port(dp, ds) {
+		if (lag_pmask & BIT(dp->index))
+			continue;
+		node_pmask |= BIT(dp->index);
+	}
+
+	if (!node_pmask)
+		return;
+
+	br_efid = rtl8365mb_lag_br_efid(ds, node_pmask, port_hint);
+
+	dsa_switch_for_each_user_port(dp, ds) {
+		if (lag_pmask & BIT(dp->index)) {
+			int ret;
+
+			if (br_efid && priv->ops->port_set_efid) {
+				ret = priv->ops->port_set_efid(priv, dp->index, br_efid);
+				if (ret)
+					dev_warn(priv->dev,
+						 "LAG bridge fixup: lag port %d EFID %u failed: %pe\n",
+						 dp->index, br_efid, ERR_PTR(ret));
+			}
+			if (priv->ops->port_set_learning) {
+				ret = priv->ops->port_set_learning(priv, dp->index, true);
+				if (ret)
+					dev_warn(priv->dev,
+						 "LAG bridge fixup: lag port %d learning failed: %pe\n",
+						 dp->index, ERR_PTR(ret));
+			}
+			/*
+			 * bond0 joins br0 as a Linux bridge port; the bridge
+			 * sets STP state on bond0 but the bonding driver may
+			 * not propagate it to individual DSA slave ports.
+			 * Meanwhile DSA marks ingress skbs with
+			 * offload_fwd_mark so the bridge skips software
+			 * forwarding, expecting the ASIC to handle it.  If
+			 * the LAG members stay in STP DISABLED (from setup),
+			 * the ASIC blocks all regular forwarding and traffic
+			 * falls into a gap.  Force FORWARDING here.
+			 */
+			if (ds->ops->port_stp_state_set)
+				ds->ops->port_stp_state_set(ds, dp->index,
+							    BR_STATE_FORWARDING);
+			/*
+			 * DSA clears broadcast/multicast/unicast flooding
+			 * when ports leave the bridge (bridge_flags val=0).
+			 * The ASIC requires a port to be in the flooding
+			 * mask AND in the source port's isolation mask for
+			 * broadcast/unknown frames to be forwarded.
+			 * Re-enable flooding so node broadcast (ARP etc.)
+			 * reaches the LAG uplink ports.
+			 */
+			if (priv->ops->port_set_ucast_flood)
+				priv->ops->port_set_ucast_flood(priv,
+								dp->index, true);
+			if (priv->ops->port_set_mcast_flood)
+				priv->ops->port_set_mcast_flood(priv,
+								dp->index, true);
+			if (priv->ops->port_set_bcast_flood)
+				priv->ops->port_set_bcast_flood(priv,
+								dp->index, true);
+			ret = priv->ops->port_add_isolation(priv, dp->index,
+							    node_pmask);
+			if (ret)
+				dev_warn(priv->dev,
+					 "LAG bridge fixup: lag port %d isolation +nodes failed: %pe\n",
+					 dp->index, ERR_PTR(ret));
+			if (cpu_pmask) {
+				ret = priv->ops->port_add_isolation(priv, dp->index,
+							    cpu_pmask);
+				if (ret)
+					dev_warn(priv->dev,
+						 "LAG bridge fixup: lag port %d isolation +cpu failed: %pe\n",
+						 dp->index, ERR_PTR(ret));
+			}
+		} else if (node_pmask & BIT(dp->index)) {
+			int ret;
+
+			ret = priv->ops->port_add_isolation(priv, dp->index,
+							    lag_pmask);
+			if (ret)
+				dev_warn(priv->dev,
+					 "LAG bridge fixup: node port %d isolation +lag failed: %pe\n",
+					 dp->index, ERR_PTR(ret));
+		}
+	}
+
+	dev_info(priv->dev,
+		 "LAG bridge uplink fixup: nodes 0x%x <-> lag 0x%x cpu 0x%x efid %u\n",
+		 node_pmask, lag_pmask, cpu_pmask, br_efid);
+
+	/* Read back ASIC state for diagnostics (reg addresses from rtl8365mb.c) */
+	{
+		u32 iso, stp, uflood, mflood, bflood;
+		int p;
+
+		regmap_read(priv->map, 0x0A00, &stp); /* MSTI_CTRL msti=0 */
+		regmap_read(priv->map, 0x0890, &uflood);
+		regmap_read(priv->map, 0x0891, &mflood);
+		regmap_read(priv->map, 0x0892, &bflood);
+		dev_info(priv->dev,
+			 "  flood masks: ucast=0x%03x mcast=0x%03x bcast=0x%03x\n",
+			 uflood & 0x7FF, mflood & 0x7FF, bflood & 0x7FF);
+		for (p = 0; p < priv->num_ports; p++) {
+			if (!((lag_pmask | node_pmask) & BIT(p)))
+				continue;
+			regmap_read(priv->map, 0x08A2 + p, &iso);
+			dev_info(priv->dev,
+				 "  port %d (%s): isolation=0x%03x stp=%u\n",
+				 p, (lag_pmask & BIT(p)) ? "lag" : "node",
+				 iso & 0x7FF,
+				 (stp >> (p * 2)) & 0x3);
+		}
+	}
+
+	/*
+	 * The internal PHY for node ports may not have completed
+	 * auto-negotiation (BMC shows NO-CARRIER even though the compute
+	 * module's link is up).  The ASIC uses its internal PHY link status
+	 * for forwarding decisions: it won't forward TO a port whose PHY
+	 * reports no link.  CPU-tagged traffic bypasses this check, which is
+	 * why node→BMC works but node→gateway doesn't.  Kick the PHY by
+	 * restarting auto-negotiation on any node port with no link.
+	 */
+	dsa_switch_for_each_user_port(dp, ds) {
+		int bmsr, bmcr;
+
+		if (!(node_pmask & BIT(dp->index)))
+			continue;
+		if (!priv->ops->phy_read || !priv->ops->phy_write)
+			continue;
+
+		bmsr = priv->ops->phy_read(priv, dp->index, MII_BMSR);
+		if (bmsr < 0 || (bmsr & BMSR_LSTATUS))
+			continue;
+
+		bmcr = priv->ops->phy_read(priv, dp->index, MII_BMCR);
+		if (bmcr < 0)
+			continue;
+
+		priv->ops->phy_write(priv, dp->index, MII_BMCR,
+				     bmcr | BMCR_ANRESTART);
+		dev_info(priv->dev,
+			 "  port %d: PHY no link (BMSR=0x%04x), restarted autoneg\n",
+			 dp->index, bmsr);
+	}
+}
+
+static int rtl8365mb_lag_apply_group(struct realtek_priv *priv,
+				     struct rtl8365mb_lag_ctx *ctx,
+				     int group, u32 member_pmask)
+{
+	u32 field_mask, shift, local_mask;
+	u8 members[RTL8365MB_TRUNK_GROUP_PORTS];
+	int nmembers = 0;
+	int i, ret;
+
+	ret = rtl8365mb_trunk_group_field(group, &field_mask, &shift);
+	if (ret)
+		return ret;
+
+	local_mask = (member_pmask & field_mask) >> shift;
+	if (!local_mask)
+		return rtl8365mb_trunk_set_group_local(priv, group, 0);
+
+	for (i = 0; i < RTL8365MB_TRUNK_GROUP_PORTS; i++) {
+		if (local_mask & BIT(i))
+			members[nmembers++] = i;
+	}
+
+	/* Dumb mode: CPU (Linux bonding) runs LACP; ASIC only aggregates
+	 * the data plane.  Matches Realtek RT_ERR_LA_DUMB / 802.1ad dumb
+	 * mode semantics and the RTL8370 vendor trunk API usage model.
+	 */
+	ret = rtl8365mb_trunk_set_mode(priv, true);
+	if (ret)
+		return ret;
+
+	ret = rtl8365mb_trunk_set_flood(priv, true);
+	if (ret)
+		return ret;
+
+	if (*ctx->hash_sel) {
+		ret = rtl8365mb_trunk_set_hash_sel(priv, *ctx->hash_sel);
+		if (ret)
+			return ret;
+	}
+
+	ret = rtl8365mb_trunk_program_hash_table(priv, group, members, nmembers);
+	if (ret)
+		return ret;
+
+	return rtl8365mb_trunk_set_group_local(priv, group, local_mask);
+}
+
+static bool rtl8365mb_lag_can_offload(struct dsa_switch *ds, struct dsa_lag lag,
+				      struct netdev_lag_upper_info *info,
+				      struct netlink_ext_ack *extack)
+{
+	struct dsa_port *dp;
+	u32 pmask = 0;
+	int members = 0, group;
+
+	if (!lag.id) {
+		NL_SET_ERR_MSG_MOD(extack, "Invalid LAG id");
+		return false;
+	}
+
+	dsa_lag_foreach_port(dp, ds->dst, &lag) {
+		members++;
+		if (dp->ds != ds) {
+			NL_SET_ERR_MSG_MOD(extack,
+					   "Cross-chip LAG offload not supported");
+			return false;
+		}
+		if (!dsa_is_user_port(ds, dp->index)) {
+			NL_SET_ERR_MSG_MOD(extack,
+					   "Only user ports can join a hardware LAG");
+			return false;
+		}
+		pmask |= BIT(dp->index);
+	}
+
+	if (members > RTL8365MB_TRUNK_GROUP_PORTS) {
+		NL_SET_ERR_MSG_MOD(extack,
+				   "Cannot offload more than 4 ports in one trunk group");
+		return false;
+	}
+
+	if (rtl8365mb_lag_group_for_pmask(pmask, &group)) {
+		NL_SET_ERR_MSG_MOD(extack,
+				   "LAG members must fit in one 4-port trunk group");
+		return false;
+	}
+
+	if (info->tx_type != NETDEV_LAG_TX_TYPE_HASH) {
+		NL_SET_ERR_MSG_MOD(extack,
+				   "Can only offload LAG using hash TX type");
+		return false;
+	}
+
+	if (info->hash_type != NETDEV_LAG_HASH_L2 &&
+	    info->hash_type != NETDEV_LAG_HASH_L23) {
+		NL_SET_ERR_MSG_MOD(extack,
+				   "Can only offload L2 or L2+L3 TX hash");
+		return false;
+	}
+
+	return true;
+}
+
+static int rtl8365mb_lag_setup_hash(struct dsa_switch *ds, struct dsa_lag lag,
+				    struct netdev_lag_upper_info *info,
+				    struct rtl8365mb_lag_ctx *ctx,
+				    struct netlink_ext_ack *extack)
+{
+	struct realtek_priv *priv = ds->priv;
+	u32 hash = 0;
+	bool unique_lag = true;
+	unsigned int i;
+
+	switch (info->hash_type) {
+	case NETDEV_LAG_HASH_L23:
+		hash |= RTL8365MB_PORT_TRUNK_HASH_SIP;
+		hash |= RTL8365MB_PORT_TRUNK_HASH_DIP;
+		fallthrough;
+	case NETDEV_LAG_HASH_L2:
+		hash |= RTL8365MB_PORT_TRUNK_HASH_SMAC;
+		hash |= RTL8365MB_PORT_TRUNK_HASH_DMAC;
+		break;
+	default:
+		return -EOPNOTSUPP;
+	}
+
+	dsa_lags_foreach_id(i, ds->dst) {
+		if (i != lag.id && dsa_lag_by_id(ds->dst, i)) {
+			unique_lag = false;
+			break;
+		}
+	}
+
+	if (unique_lag) {
+		*ctx->hash_sel = hash;
+	} else if (*ctx->hash_sel != hash) {
+		NL_SET_ERR_MSG_MOD(extack,
+				   "Mismatched hash mode across LAGs is not supported");
+		return -EOPNOTSUPP;
+	}
+
+	return rtl8365mb_trunk_set_hash_sel(priv, *ctx->hash_sel);
+}
+
+static int rtl8365mb_lag_refresh(struct dsa_switch *ds, struct dsa_lag lag,
+				 struct rtl8365mb_lag_ctx *ctx)
+{
+	struct realtek_priv *priv = ds->priv;
+	u32 pmask;
+	int group, ret;
+
+	ret = rtl8365mb_lag_member_pmask(ds, lag, &pmask);
+	if (ret)
+		return 0;
+
+	if (!pmask) {
+		priv->lag_member_pmask = 0;
+		return 0;
+	}
+
+	ret = rtl8365mb_lag_group_for_pmask(pmask, &group);
+	if (ret)
+		return ret;
+
+	if (hweight32(pmask) < 2) {
+		priv->lag_member_pmask = 0;
+		return rtl8365mb_trunk_set_group_local(priv, group, 0);
+	}
+
+	ret = rtl8365mb_lag_apply_group(priv, ctx, group, pmask);
+	if (ret)
+		return ret;
+
+	priv->lag_member_pmask = pmask;
+	rtl8365mb_lag_bridge_isolation_fixup(ds, pmask, -1);
+
+	return 0;
+}
+
+/**
+ * rtl8365mb_lag_bridge_fixup_refresh() - re-run bridge isolation fixup
+ * @ds: DSA switch
+ * @port_hint: port that just joined/left a bridge, or -1
+ *
+ * Called from port_bridge_join/leave to refresh the ASIC isolation and EFID
+ * configuration when the bridge topology changes after LAG setup.
+ */
+void rtl8365mb_lag_bridge_fixup_refresh(struct dsa_switch *ds, int port_hint)
+{
+	struct realtek_priv *priv = ds->priv;
+	u32 pmask = priv->lag_member_pmask;
+
+	if (pmask && hweight32(pmask) >= 2)
+		rtl8365mb_lag_bridge_isolation_fixup(ds, pmask, port_hint);
+}
+
+static struct rtl8365mb_lag_ctx rtl8365mb_lag_ctx_get(struct dsa_switch *ds)
+{
+	struct realtek_priv *priv = ds->priv;
+
+	return (struct rtl8365mb_lag_ctx) {
+		.lock = &priv->lag_lock,
+		.hash_sel = &priv->lag_hash_sel,
+	};
+}
+
+int rtl8365mb_port_lag_join(struct dsa_switch *ds, int port, struct dsa_lag lag,
+			    struct netdev_lag_upper_info *info,
+			    struct netlink_ext_ack *extack)
+{
+	struct rtl8365mb_lag_ctx ctx = rtl8365mb_lag_ctx_get(ds);
+	int ret;
+
+	if (!rtl8365mb_lag_can_offload(ds, lag, info, extack))
+		return -EOPNOTSUPP;
+
+	mutex_lock(ctx.lock);
+	ret = rtl8365mb_lag_setup_hash(ds, lag, info, &ctx, extack);
+	if (!ret)
+		ret = rtl8365mb_lag_refresh(ds, lag, &ctx);
+	mutex_unlock(ctx.lock);
+
+	return ret;
+}
+
+int rtl8365mb_port_lag_leave(struct dsa_switch *ds, int port,
+			     struct dsa_lag lag)
+{
+	struct rtl8365mb_lag_ctx ctx = rtl8365mb_lag_ctx_get(ds);
+	int ret;
+
+	mutex_lock(ctx.lock);
+	ret = rtl8365mb_lag_refresh(ds, lag, &ctx);
+	mutex_unlock(ctx.lock);
+
+	return ret;
+}
+
+int rtl8365mb_port_lag_change(struct dsa_switch *ds, int port)
+{
+	struct dsa_port *dp = dsa_to_port(ds, port);
+	struct rtl8365mb_lag_ctx ctx = rtl8365mb_lag_ctx_get(ds);
+	int ret = 0;
+
+	if (!dp->lag)
+		return 0;
+
+	mutex_lock(ctx.lock);
+	ret = rtl8365mb_lag_refresh(ds, *dp->lag, &ctx);
+	mutex_unlock(ctx.lock);
+
+	return ret;
+}
