 #define RTL8_4_LEARN_DIS		BIT(5)
+#define RTL8_4_KEEP			BIT(7)
 
 #define RTL8_4_TX			GENMASK(3, 0)
 #define RTL8_4_RX			GENMASK(10, 0)
@@ -112,11 +115,12 @@ static void rtl8_4_write_tag(struct sk_buff *skb, struct net_device *dev,
