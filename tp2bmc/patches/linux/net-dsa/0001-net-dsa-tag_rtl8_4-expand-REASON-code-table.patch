From 03fc4a11d2f88e7dd0b46f7cb13b566ac08be3d8 Mon Sep 17 00:00:00 2001
From: Sam Edwards <CFSworks@gmail.com>
Date: Sat, 9 May 2026 13:37:21 +0200
Subject: [PATCH 1/4] net: dsa: tag_rtl8_4: expand REASON code table

The RTL8365MB family generates more trap reason codes than just
0x00 (forward) and 0x80 (CPU trap). Document and #define the codes
observed on Turing Pi 2 boards (dot1x unauthorized, learning-limit
exceeded, unknown source/destination MAC variants) so the driver
can mark them appropriately when bridge offload is enabled.

Switch the rtl8_4_read_tag() check from "not trap" to "is forward"
so any new (currently unhandled) trap reason is treated as a
trapped frame by default rather than silently mis-marked as
hardware-forwarded.

Signed-off-by: Sam Edwards <CFSworks@gmail.com>
---
 net/dsa/tag_rtl8_4.c | 22 +++++++++++++++++-----
 1 file changed, 17 insertions(+), 5 deletions(-)

diff --git a/net/dsa/tag_rtl8_4.c b/net/dsa/tag_rtl8_4.c
index 15c2bae2b429..cc3be77eeb9a 100644
--- a/net/dsa/tag_rtl8_4.c
+++ b/net/dsa/tag_rtl8_4.c
@@ -35,8 +35,14 @@
  *    X          | reserved
  *   ------------+-------------
  *    REASON     | reason for forwarding packet to CPU
- *               | 0: packet was forwarded or flooded to CPU
- *               | 80: packet was trapped to CPU
+ *               | 0x00: packet was forwarded or flooded to CPU
+ *               | 0x41: dot1x unauthorized
+ *               | 0x4B: port learning limit exceeded
+ *               | 0x50: unknown unicast destination MAC
+ *               | 0x51: unknown multicast destination MAC
+ *               | 0x54: unknown source MAC
+ *               | 0x55: unmatched source MAC
+ *               | 0x80: packet was trapped to CPU
  *    FID_EN     | 1: packet has an FID
  *               | 0: no FID
  *    FID        | FID of packet (if FID_EN=1)
@@ -92,8 +98,14 @@
 #define RTL8_4_PROTOCOL			GENMASK(15, 8)
 #define   RTL8_4_PROTOCOL_RTL8365MB	0x04
 #define RTL8_4_REASON			GENMASK(7, 0)
-#define   RTL8_4_REASON_FORWARD		0
-#define   RTL8_4_REASON_TRAP		80
+#define   RTL8_4_REASON_FORWARD		0x00
+#define   RTL8_4_REASON_1XUNAUTH	0x41
+#define   RTL8_4_REASON_LUT_OVER	0x4B
+#define   RTL8_4_REASON_UNK_UNICAST	0x50
+#define   RTL8_4_REASON_UNK_MULTICAST	0x51
+#define   RTL8_4_REASON_UNK_SOURCE	0x54
+#define   RTL8_4_REASON_UNMATCH_SOURCE	0x55
+#define   RTL8_4_REASON_TRAP		0x80
 
 #define RTL8_4_LEARN_DIS		BIT(5)
 
@@ -188,7 +200,7 @@ static int rtl8_4_read_tag(struct sk_buff *skb, struct net_device *dev,
 		return -ENOENT;
 	}
 
-	if (reason != RTL8_4_REASON_TRAP)
+	if (reason == RTL8_4_REASON_FORWARD)
 		dsa_default_offload_fwd_mark(skb);
 
 	return 0;
