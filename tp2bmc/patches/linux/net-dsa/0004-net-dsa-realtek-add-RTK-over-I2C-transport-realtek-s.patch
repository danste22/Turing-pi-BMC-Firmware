From 179bcfe06d4b5208761ddc3258ca0d5d518fb1b2 Mon Sep 17 00:00:00 2001
From: Sam Edwards <CFSworks@gmail.com>
Date: Sat, 9 May 2026 13:41:49 +0200
Subject: [PATCH 4/4] net: dsa: realtek: add RTK-over-I2C transport
 (realtek-smi-i2c)

Some members of the RTL836x family expose their management register
file over an I2C-like serial interface that re-uses the SMI byte
protocol but talks at I2C voltage levels and timings. The Turing Pi 2
cluster board (v2.5+) wires an RTL8370MB-CG to the BMC's I2C bus this
way; the chip's 7-bit slave address (0x5c) is fixed in silicon.

Add a minimal I2C transport driver layered on top of the upstream
rtl83xx_probe()/rtl83xx_register_switch() helpers. The driver only
provides the realtek_interface_info reg_read/reg_write callbacks; all
chip-specific behaviour lives in the existing rtl8365mb subdriver and
in the generic rtl83xx core.

Reads use the "RTK" I2C protocol: a 3-message transfer where a
zero-length I2C_M_RD sends addr+R, then a NOSTART write sends the
2-byte register address (little-endian, low byte first), followed
by a NOSTART read for the 2-byte value (also little-endian).
Requires I2C_FUNC_NOSTART (provided by i2c-gpio / i2c-algo-bit).

Adds:
  drivers/net/dsa/realtek/realtek-smi-i2c.c
  CONFIG_NET_DSA_REALTEK_SMI_I2C
  Makefile entry tying it into the existing realtek_dsa module set

Replaces the GPIO bit-bang shim and ad-hoc regmap wiring carried in
the v6.8.12-era out-of-tree realtek-switch.patch (per the
patch-audit/net-dsa/realtek-switch.md recommendation).

Co-developed-by: Sven Rademakers <sven@turingpi.com>
Signed-off-by: Sven Rademakers <sven@turingpi.com>
Signed-off-by: Sam Edwards <CFSworks@gmail.com>
---
 drivers/net/dsa/realtek/Kconfig           |  14 ++
 drivers/net/dsa/realtek/Makefile          |   1 +
 drivers/net/dsa/realtek/realtek-smi-i2c.c | 173 ++++++++++++++++++++++
 3 files changed, 188 insertions(+), 1 deletion(-)
 create mode 100644 drivers/net/dsa/realtek/realtek-smi-i2c.c

diff --git a/drivers/net/dsa/realtek/Kconfig b/drivers/net/dsa/realtek/Kconfig
index d6eb6713e5f6..e7ec785c8844 100644
--- a/drivers/net/dsa/realtek/Kconfig
+++ b/drivers/net/dsa/realtek/Kconfig
@@ -29,9 +29,22 @@ config NET_DSA_REALTEK_SMI
 	  Select to enable support for registering switches connected
 	  through SMI.
 
+config NET_DSA_REALTEK_SMI_I2C
+	tristate "Realtek RTK-over-I2C transport"
+	depends on OF && I2C
+	select REGMAP_I2C
+	help
+	  Select to enable support for registering RTL836x switches that
+	  are wired to the SoC over an I2C bus rather than SMI bit-bang
+	  GPIOs (used by the Turing Pi 2 cluster board with the
+	  RTL8370MB-CG).
+
+	  Requires i2c-gpio (bit-bang); the chip briefly holds SDA after
+	  the register-address ACK, which confuses fast HW controllers.
+
 config NET_DSA_REALTEK_RTL8365MB
 	tristate "Realtek RTL8365MB switch driver"
-	depends on NET_DSA_REALTEK_SMI || NET_DSA_REALTEK_MDIO
+	depends on NET_DSA_REALTEK_SMI || NET_DSA_REALTEK_MDIO || NET_DSA_REALTEK_SMI_I2C
 	select NET_DSA_TAG_RTL8_4
 	help
 	  Select to enable support for Realtek RTL8365MB-VC and RTL8367S.
diff --git a/drivers/net/dsa/realtek/Makefile b/drivers/net/dsa/realtek/Makefile
index 17367bcba496..0cd9a0a6789c 100644
--- a/drivers/net/dsa/realtek/Makefile
+++ b/drivers/net/dsa/realtek/Makefile
@@ -16,3 +16,4 @@ ifdef CONFIG_NET_DSA_REALTEK_RTL8366RB_LEDS
 rtl8366-objs 				+= rtl8366rb-leds.o
 endif
 obj-$(CONFIG_NET_DSA_REALTEK_RTL8365MB) += rtl8365mb.o
+obj-$(CONFIG_NET_DSA_REALTEK_SMI_I2C) += realtek-smi-i2c.o
diff --git a/drivers/net/dsa/realtek/realtek-smi-i2c.c b/drivers/net/dsa/realtek/realtek-smi-i2c.c
new file mode 100644
index 000000000000..8d8abbd6bd5b
--- /dev/null
+++ b/drivers/net/dsa/realtek/realtek-smi-i2c.c
@@ -0,0 +1,173 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Realtek RTK-style I2C transport for the realtek-dsa subdrivers.
+ *
+ * Some members of the RTL836x family (notably the RTL8370MB-CG used on
+ * the Turing Pi 2 cluster board, v2.5+) expose their management
+ * register file over an I2C-like serial interface that re-uses the
+ * SMI byte protocol but talks at I2C voltage levels and I2C bit
+ * timings. The chip's 7-bit address is fixed in silicon (0x5c for
+ * the RTL836x family).
+ *
+ * Reads use the "RTK" I2C protocol: a 3-message transfer where a
+ * zero-length I2C_M_RD sends addr+R, then a NOSTART write sends
+ * the 2-byte register address (little-endian), followed by a
+ * NOSTART read for the 2-byte value (also little-endian).
+ * Requires I2C_FUNC_NOSTART (provided by i2c-gpio / i2c-algo-bit).
+ *
+ * Layered on top of the upstream rtl83xx_probe()/rtl83xx_register_switch()
+ * helpers, this driver adds nothing chip-specific: it is just the I2C
+ * transport glue that fills in the realtek_interface_info reg_read /
+ * reg_write callbacks.
+ *
+ * Copyright (C) 2024 Sam Edwards <CFSworks@gmail.com>
+ * Copyright (C) 2024 Sven Rademakers <sven@turingpi.com>
+ */
+
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/regmap.h>
+
+#include "realtek.h"
+#include "rtl83xx.h"
+
+static int realtek_smi_i2c_read(void *ctx, u32 reg, u32 *val)
+{
+	struct realtek_priv *priv = ctx;
+	struct i2c_client *client = to_i2c_client(priv->dev);
+	u8 txbuf[2] = { reg & 0xff, (reg >> 8) & 0xff };
+	u8 rxbuf[2] = { 0xff, 0xff };
+	/*
+	 * RTK I2C read — 3-message transfer matching the Realtek SMI
+	 * byte protocol.  All multi-byte fields are little-endian on
+	 * the wire (low byte first), matching the original SMI bit-bang
+	 * order: ADDR[7:0] then ADDR[15:8], DATA[7:0] then DATA[15:8].
+	 *
+	 *   [S][addr+R][reg_lo][reg_hi][val_lo][val_hi][P]
+	 */
+	struct i2c_msg msgs[3] = {
+		{ .addr = client->addr, .flags = I2C_M_RD,
+		  .len = 0 },
+		{ .addr = client->addr, .flags = I2C_M_NOSTART,
+		  .len = sizeof(txbuf), .buf = txbuf },
+		{ .addr = client->addr,
+		  .flags = I2C_M_RD | I2C_M_NOSTART,
+		  .len = sizeof(rxbuf), .buf = rxbuf },
+	};
+	int ret;
+
+	ret = i2c_transfer(client->adapter, msgs, ARRAY_SIZE(msgs));
+	if (ret < 0)
+		return ret;
+	if (ret != ARRAY_SIZE(msgs))
+		return -EIO;
+
+	*val = (u32)rxbuf[0] | ((u32)rxbuf[1] << 8);
+	return 0;
+}
+
+static int realtek_smi_i2c_write(void *ctx, u32 reg, u32 val)
+{
+	struct realtek_priv *priv = ctx;
+	struct i2c_client *client = to_i2c_client(priv->dev);
+	u8 txbuf[4] = {
+		reg & 0xff, (reg >> 8) & 0xff,
+		val & 0xff, (val >> 8) & 0xff,
+	};
+	int ret;
+
+	ret = i2c_master_send(client, txbuf, sizeof(txbuf));
+	if (ret < 0)
+		return ret;
+	if (ret != sizeof(txbuf))
+		return -EIO;
+
+	return 0;
+}
+
+static const struct realtek_interface_info realtek_smi_i2c_info = {
+	.reg_read = realtek_smi_i2c_read,
+	.reg_write = realtek_smi_i2c_write,
+};
+
+static int realtek_smi_i2c_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct realtek_priv *priv;
+	const struct realtek_variant *variant;
+	int ret;
+
+	priv = rtl83xx_probe(dev, &realtek_smi_i2c_info);
+	if (IS_ERR(priv))
+		return PTR_ERR(priv);
+
+	priv->write_reg_noack = realtek_smi_i2c_write;
+
+	variant = priv->variant;
+	if (variant->i2c_addr && client->addr != variant->i2c_addr)
+		dev_warn(dev,
+			 "I2C address 0x%02x does not match variant default 0x%02x\n",
+			 client->addr, variant->i2c_addr);
+
+	i2c_set_clientdata(client, priv);
+
+	ret = rtl83xx_register_switch(priv);
+	if (ret) {
+		rtl83xx_remove(priv);
+		return ret;
+	}
+
+	return 0;
+}
+
+static void realtek_smi_i2c_remove(struct i2c_client *client)
+{
+	struct realtek_priv *priv = i2c_get_clientdata(client);
+
+	if (!priv)
+		return;
+
+	rtl83xx_unregister_switch(priv);
+	rtl83xx_remove(priv);
+}
+
+static void realtek_smi_i2c_shutdown(struct i2c_client *client)
+{
+	struct realtek_priv *priv = i2c_get_clientdata(client);
+
+	if (!priv)
+		return;
+
+	rtl83xx_shutdown(priv);
+}
+
+static const struct of_device_id realtek_smi_i2c_of_match[] = {
+	{ .compatible = "realtek,rtl8365mb-i2c", .data = &rtl8365mb_variant },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, realtek_smi_i2c_of_match);
+
+static const struct i2c_device_id realtek_smi_i2c_id[] = {
+	{ "rtl8365mb-i2c", 0 },
+	{ }
+};
+MODULE_DEVICE_TABLE(i2c, realtek_smi_i2c_id);
+
+static struct i2c_driver realtek_smi_i2c_driver = {
+	.driver = {
+		.name = "realtek-smi-i2c",
+		.of_match_table = realtek_smi_i2c_of_match,
+	},
+	.probe		= realtek_smi_i2c_probe,
+	.remove		= realtek_smi_i2c_remove,
+	.shutdown	= realtek_smi_i2c_shutdown,
+	.id_table	= realtek_smi_i2c_id,
+};
+module_i2c_driver(realtek_smi_i2c_driver);
+
+MODULE_AUTHOR("Sam Edwards <CFSworks@gmail.com>");
+MODULE_AUTHOR("Sven Rademakers <sven@turingpi.com>");
+MODULE_DESCRIPTION("Realtek DSA RTK-over-I2C transport");
+MODULE_LICENSE("GPL");
+MODULE_IMPORT_NS("REALTEK_DSA");
-- 
