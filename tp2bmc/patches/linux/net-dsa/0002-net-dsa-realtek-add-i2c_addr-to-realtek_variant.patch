From 66e670a2a77e2be80ea53150b6090e1f86a9b772 Mon Sep 17 00:00:00 2001
From: Sam Edwards <CFSworks@gmail.com>
Date: Sat, 9 May 2026 13:39:05 +0200
Subject: [PATCH 2/4] net: dsa: realtek: add i2c_addr to realtek_variant

The Realtek RTL836x family can be programmed over either the SMI
bit-bang protocol or a Realtek-proprietary I2C variant ("RTK"-mode
I2C). The latter is used on the Turing Pi 2 cluster board, where the
RTL8370MB-CG sits on the BMC's I2C bus rather than on dedicated SMI
GPIOs.

Add an i2c_addr field to struct realtek_variant so that a forthcoming
realtek-smi-i2c transport (drivers/net/dsa/realtek/realtek-smi-i2c.c)
can pick up the default 7-bit address per chip family. Zero means the
chip is not wired up over I2C.

Populate the field for rtl8365mb_variant with 0x5c, the address
documented in the Realtek register guide for the RTL836x family.
rtl8366rb_variant is left at the default zero (no I2C transport
available).

Signed-off-by: Sam Edwards <CFSworks@gmail.com>
---
 drivers/net/dsa/realtek/realtek.h   | 6 ++++++
 drivers/net/dsa/realtek/rtl8365mb.c | 1 +
 2 files changed, 7 insertions(+)

diff --git a/drivers/net/dsa/realtek/realtek.h b/drivers/net/dsa/realtek/realtek.h
index c03485a80d93..ce29fda25125 100644
--- a/drivers/net/dsa/realtek/realtek.h
+++ b/drivers/net/dsa/realtek/realtek.h
@@ -119,6 +119,12 @@ struct realtek_variant {
 	unsigned int clk_delay;
 	u8 cmd_read;
 	u8 cmd_write;
+	/*
+	 * Default 7-bit I2C address used when this chip is wired to the
+	 * Realtek "RTK"-style transport over I2C (see realtek-smi-i2c.c).
+	 * Zero means "not supported on I2C".
+	 */
+	u8 i2c_addr;
 	size_t chip_data_sz;
 };
 
diff --git a/drivers/net/dsa/realtek/rtl8365mb.c b/drivers/net/dsa/realtek/rtl8365mb.c
index 3a48db295e7e..dd02f86bc549 100644
--- a/drivers/net/dsa/realtek/rtl8365mb.c
+++ b/drivers/net/dsa/realtek/rtl8365mb.c
@@ -2148,6 +2148,7 @@ const struct realtek_variant rtl8365mb_variant = {
 	.clk_delay = 10,
 	.cmd_read = 0xb9,
 	.cmd_write = 0xb8,
+	.i2c_addr = 0x5c, /* Realtek RTL836x default I2C slave address */
 	.chip_data_sz = sizeof(struct rtl8365mb),
 };
 
