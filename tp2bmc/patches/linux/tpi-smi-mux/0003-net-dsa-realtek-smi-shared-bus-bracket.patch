From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TP2 BMC <tp2bmc@local>
Date: Mon, 02 Jun 2026 12:00:00 +0200
Subject: [PATCH 3/3] net: dsa: realtek-smi: bracket SMI ops with shared-bus arbiter

When turing,smi-arbiter is present in DT, lock the shared I2C adapter,
select pinctrl "smi_mode", and quiesce TWI before each SMI register
access. Used by the Turing Pi 2 SMI mux PoC.

Signed-off-by: TP2 BMC <tp2bmc@local>
---
 drivers/net/dsa/realtek/realtek-smi.c | 58 ++++++++++++++++++++++++++++++++-
 drivers/net/dsa/realtek/realtek.h     |  1 +
 2 files changed, 58 insertions(+), 1 deletion(-)

diff --git a/drivers/net/dsa/realtek/realtek-smi.c b/drivers/net/dsa/realtek/realtek-smi.c
index aaaaaaaa..bbbbbbbb 100644
--- a/drivers/net/dsa/realtek/realtek-smi.c
+++ b/drivers/net/dsa/realtek/realtek-smi.c
@@ -31,6 +31,7 @@
 #include <linux/spinlock.h>
 #include <linux/skbuff.h>
 #include <linux/of.h>
+#include <linux/of_platform.h>
 #include <linux/delay.h>
 #include <linux/gpio/consumer.h>
 #include <linux/platform_device.h>
@@ -42,6 +43,8 @@
 #include "realtek-smi.h"
 #include "rtl83xx.h"
 
+#include <linux/tpi-i2c-smi-arbiter.h>
+
 #define REALTEK_SMI_ACK_RETRY_COUNT		5
 
 static inline void realtek_smi_clk_delay(struct realtek_priv *priv)
@@ -49,6 +52,20 @@ static inline void realtek_smi_clk_delay(struct realtek_priv *priv)
 	ndelay(priv->variant->clk_delay);
 }
 
+static int realtek_smi_bus_begin(struct realtek_priv *priv)
+{
+	if (!priv->smi_arb)
+		return 0;
+
+	return tpi_smi_arb_begin(priv->smi_arb);
+}
+
+static void realtek_smi_bus_end(struct realtek_priv *priv)
+{
+	if (priv->smi_arb)
+		tpi_smi_arb_end(priv->smi_arb);
+}
+
 static void realtek_smi_start(struct realtek_priv *priv)
 {
 	/* Set GPIO pins to output mode, with initial state:
@@ -203,6 +219,10 @@ static int realtek_smi_read_reg(struct realtek_priv *priv, u32 addr, u32 *data)
 	u8 lo = 0;
 	u8 hi = 0;
 	int ret;
+
+	ret = realtek_smi_bus_begin(priv);
+	if (ret)
+		return ret;
 
 	spin_lock_irqsave(&priv->lock, flags);
 
@@ -235,6 +255,7 @@ static int realtek_smi_read_reg(struct realtek_priv *priv, u32 addr, u32 *data)
  out:
 	realtek_smi_stop(priv);
 	spin_unlock_irqrestore(&priv->lock, flags);
+	realtek_smi_bus_end(priv);
 
 	return ret;
 }
@@ -245,6 +266,10 @@ static int realtek_smi_write_reg(struct realtek_priv *priv,
 	unsigned long flags;
 	int ret;
 
+	ret = realtek_smi_bus_begin(priv);
+	if (ret)
+		return ret;
+
 	spin_lock_irqsave(&priv->lock, flags);
 
 	realtek_smi_start(priv);
@@ -282,6 +307,7 @@ static int realtek_smi_write_reg(struct realtek_priv *priv,
  out:
 	realtek_smi_stop(priv);
 	spin_unlock_irqrestore(&priv->lock, flags);
+	realtek_smi_bus_end(priv);
 
 	return ret;
 }
@@ -338,6 +364,20 @@ int realtek_smi_probe(struct platform_device *pdev)
 	if (IS_ERR(priv))
 		return PTR_ERR(priv);
 
+	if (dev->of_node) {
+		struct device_node *arb_np;
+
+		arb_np = of_parse_phandle(dev->of_node, "turing,smi-arbiter", 0);
+		if (arb_np) {
+			struct platform_device *arb_pdev = of_find_device_by_node(arb_np);
+
+			of_node_put(arb_np);
+			if (!arb_pdev)
+				return -EPROBE_DEFER;
+			priv->smi_arb = &arb_pdev->dev;
+		}
+	}
+
 	/* Fetch MDIO pins */
 	priv->mdc = devm_gpiod_get_optional(dev, "mdc", GPIOD_OUT_LOW);
 	if (IS_ERR(priv->mdc)) {
diff --git a/drivers/net/dsa/realtek/realtek.h b/drivers/net/dsa/realtek/realtek.h
index cccccccc..dddddddd 100644
--- a/drivers/net/dsa/realtek/realtek.h
+++ b/drivers/net/dsa/realtek/realtek.h
@@ -49,6 +49,7 @@ struct realtek_priv {
 	struct device		*dev;
 	struct reset_control    *reset_ctl;
 	struct gpio_desc	*reset;
+	struct device		*smi_arb;
 	struct gpio_desc	*mdc;
 	struct gpio_desc	*mdio;
 	struct regmap		*map;
-- 
2.50.1
