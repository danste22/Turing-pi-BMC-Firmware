From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TP2 BMC <tp2bmc@local>
Date: Wed, 01 Jul 2026 12:00:00 +0200
Subject: [PATCH 4/4] tpi-smi-mux: fix shared PE12/PE13 probe and pinctrl order

PE12/PE13 are owned by &i2c2 in "default" TWI mode. The switch must not
request them via gpiolib at probe time, and the arbiter must quiesce the
TWI controller before selecting the "smi_mode" pinctrl profile.

Signed-off-by: TP2 BMC <tp2bmc@local>
---
 drivers/i2c/busses/tpi-i2c-smi-arbiter.c | 14 +++++++-----
 drivers/net/dsa/realtek/realtek-smi.c    | 49 ++++++++++++++++++++++++++++----
 2 files changed, 51 insertions(+), 12 deletions(-)

diff --git a/drivers/i2c/busses/tpi-i2c-smi-arbiter.c b/drivers/i2c/busses/tpi-i2c-smi-arbiter.c
index a1b2c3d4e5f6..b2c3d4e5f6a7 100644
--- a/drivers/i2c/busses/tpi-i2c-smi-arbiter.c
+++ b/drivers/i2c/busses/tpi-i2c-smi-arbiter.c
@@ -45,15 +45,17 @@ int tpi_smi_arb_begin(struct device *arb_dev)
 	mutex_lock(&arb->lock);
 	i2c_lock_bus(arb->adap, I2C_LOCK_ROOT_ADAPTER);
 
+	if (pm_runtime_enabled(&arb->adap->dev))
+		pm_runtime_put_sync(&arb->adap->dev);
+
+	pinctrl_pm_select_idle_state(&arb->adap->dev);
+
 	ret = pinctrl_select_state(arb->pctl, arb->st_smi);
 	if (ret) {
 		dev_err(arb->dev, "pinctrl smi_mode failed: %d\n", ret);
 		goto unlock_bus;
 	}
 
-	if (pm_runtime_enabled(&arb->adap->dev))
-		pm_runtime_put_sync(&arb->adap->dev);
-
 	arb->bracket_count++;
 	return 0;
 
@@ -72,13 +74,15 @@ void tpi_smi_arb_end(struct device *arb_dev)
 	if (!arb)
 		return;
 
-	if (pm_runtime_enabled(&arb->adap->dev))
-		pm_runtime_get_sync(&arb->adap->dev);
-
 	ret = pinctrl_select_state(arb->pctl, arb->st_default);
 	if (ret)
 		dev_err(arb->dev, "pinctrl default failed: %d\n", ret);
 
+	pinctrl_pm_select_default_state(&arb->adap->dev);
+
+	if (pm_runtime_enabled(&arb->adap->dev))
+		pm_runtime_get_sync(&arb->adap->dev);
+
 	i2c_unlock_bus(arb->adap, I2C_LOCK_ROOT_ADAPTER);
 	mutex_unlock(&arb->lock);
 }
diff --git a/drivers/net/dsa/realtek/realtek-smi.c b/drivers/net/dsa/realtek/realtek-smi.c
index bbbbbbbb..cccccccc 100644
--- a/drivers/net/dsa/realtek/realtek-smi.c
+++ b/drivers/net/dsa/realtek/realtek-smi.c
@@ -52,12 +52,43 @@ static inline void realtek_smi_clk_delay(struct realtek_priv *priv)
 	ndelay(priv->variant->clk_delay);
 }
 
+static int realtek_smi_ensure_gpios(struct realtek_priv *priv)
+{
+	if (priv->mdc && priv->mdio)
+		return 0;
+
+	priv->mdc = devm_gpiod_get_optional(priv->dev, "mdc", GPIOD_OUT_LOW);
+	if (IS_ERR(priv->mdc))
+		return PTR_ERR(priv->mdc);
+
+	priv->mdio = devm_gpiod_get_optional(priv->dev, "mdio", GPIOD_OUT_LOW);
+	if (IS_ERR(priv->mdio))
+		return PTR_ERR(priv->mdio);
+
+	if (!priv->mdc || !priv->mdio)
+		return -EINVAL;
+
+	return 0;
+}
+
 static int realtek_smi_bus_begin(struct realtek_priv *priv)
 {
+	int ret;
+
 	if (!priv->smi_arb)
 		return 0;
 
-	return tpi_smi_arb_begin(priv->smi_arb);
+	ret = tpi_smi_arb_begin(priv->smi_arb);
+	if (ret)
+		return ret;
+
+	ret = realtek_smi_ensure_gpios(priv);
+	if (ret) {
+		tpi_smi_arb_end(priv->smi_arb);
+		return ret;
+	}
+
+	return 0;
 }
 
 static void realtek_smi_bus_end(struct realtek_priv *priv)
@@ -375,21 +406,25 @@ int realtek_smi_probe(struct platform_device *pdev)
 			of_node_put(arb_np);
 			if (!arb_pdev)
 				return -EPROBE_DEFER;
+			if (!platform_get_drvdata(arb_pdev))
+				return -EPROBE_DEFER;
 			priv->smi_arb = &arb_pdev->dev;
 		}
 	}
 
-	/* Fetch MDIO pins */
-	priv->mdc = devm_gpiod_get_optional(dev, "mdc", GPIOD_OUT_LOW);
-	if (IS_ERR(priv->mdc)) {
-		rtl83xx_remove(priv);
-		return PTR_ERR(priv->mdc);
-	}
+	if (!priv->smi_arb) {
+		/* Fetch MDIO pins */
+		priv->mdc = devm_gpiod_get_optional(dev, "mdc", GPIOD_OUT_LOW);
+		if (IS_ERR(priv->mdc)) {
+			rtl83xx_remove(priv);
+			return PTR_ERR(priv->mdc);
+		}
 
-	priv->mdio = devm_gpiod_get_optional(dev, "mdio", GPIOD_OUT_LOW);
-	if (IS_ERR(priv->mdio)) {
-		rtl83xx_remove(priv);
-		return PTR_ERR(priv->mdio);
+		priv->mdio = devm_gpiod_get_optional(dev, "mdio", GPIOD_OUT_LOW);
+		if (IS_ERR(priv->mdio)) {
+			rtl83xx_remove(priv);
+			return PTR_ERR(priv->mdio);
+		}
 	}
 
 	priv->write_reg_noack = realtek_smi_write_reg_noack;
