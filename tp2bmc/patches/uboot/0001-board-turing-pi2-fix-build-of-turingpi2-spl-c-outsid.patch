From e3e1c5bb50daf04f96b37f292111bfb4895a0aa8 Mon Sep 17 00:00:00 2001
From: TP2 BMC patcher <tp2bmc@local>
Date: Sun, 10 May 2026 00:55:16 +0200
Subject: [PATCH] board: turing: pi2: fix SPL-only symbols without hiding
 compute_crc

Commit e79807df6c added EEPROM/CRC/latch helpers that depend on udelay(),
crc32() and the legacy i2c_read() API. In this U-Boot fork <common.h>
no longer re-exports <linux/delay.h> nor <u-boot/crc.h>, and the legacy
I2C API is only visible when CONFIG_SPL_SYS_I2C_LEGACY is enabled for
the SPL build.

The board file is linked into both SPL and proper U-Boot via obj-y.
Gate EEPROM/latch/FEL init (tp_board_init and its static helpers) behind
CONFIG_SPL_BUILD, but keep compute_crc() outside that guard: cmd/tpi_info.c
calls it from proper U-Boot to validate the SPL handoff bloblist payload.

Add <linux/delay.h> and <u-boot/crc.h> for udelay()/crc32() in the SPL
portion and crc32() for compute_crc() in both contexts.

Signed-off-by: TP2 BMC patcher <tp2bmc@local>
---
 board/turing/pi2/turingpi2-spl.c | 23 +++++++++++++++--------
 1 file changed, 15 insertions(+), 8 deletions(-)

diff --git a/board/turing/pi2/turingpi2-spl.c b/board/turing/pi2/turingpi2-spl.c
index 2860365758..2995c54253 100644
--- a/board/turing/pi2/turingpi2-spl.c
+++ b/board/turing/pi2/turingpi2-spl.c
@@ -14,6 +14,20 @@
 #include <i2c.h>
 #include <init.h>
 #include <sunxi_gpio.h>
+#include <linux/delay.h>
+#include <u-boot/crc.h>
+
+u32 compute_crc(tpi_board_info *info)
+{
+	int info_offset = offsetof(tpi_board_info, hdr_version);
+	u32 crc = crc32(0, (void *)info + info_offset,
+			sizeof(tpi_board_info) - info_offset);
+
+	return ((crc & 0x000000FF) << 24) | ((crc & 0x0000FF00) << 8) |
+	       ((crc & 0x00FF0000) >> 8) | ((crc & 0xFF000000) >> 24);
+}
+
+#ifdef CONFIG_SPL_BUILD
 
 #define TURING_PI2_LATCH_STATE_ADDR 0x0709010c
 #define TURING_PI2_BOOT_COOKIE_ADDR 0x07090108
@@ -67,14 +81,6 @@ static int board_info_from_eeprom(tpi_board_info *info) {
   return 0;
 }
 
-u32 compute_crc(tpi_board_info *info) {
-  int info_offset = offsetof(tpi_board_info, hdr_version);
-  u32 crc = crc32(0, (void *)info + info_offset,
-                  sizeof(tpi_board_info) - info_offset);
-  return ((crc & 0x000000FF) << 24) | ((crc & 0x0000FF00) << 8) |
-         ((crc & 0x00FF0000) >> 8) | ((crc & 0xFF000000) >> 24);
-}
-
 #if CONFIG_IS_ENABLED(BLOBLIST)
 tpi_board_info *setup_bloblist(void) {
   int init_res = bloblist_init();
@@ -135,6 +141,7 @@ int tp_board_init(void) {
 #endif
   return 0;
 }
+#endif /* CONFIG_SPL_BUILD */
 
 #if CONFIG_IS_ENABLED(OF_CONTROL)
 /// This method determines which device tree to load. The main
-- 
