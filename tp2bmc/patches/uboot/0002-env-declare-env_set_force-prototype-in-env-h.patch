From 64611931c2e7e070629018e45fe64965992d2c3c Mon Sep 17 00:00:00 2001
From: TP2 BMC patcher <tp2bmc@local>
Date: Sat, 9 May 2026 22:50:58 +0200
Subject: [PATCH] env: declare env_set_force() prototype in env.h

The Turing fork added env_set_force() in cmd/nvedit.c and switched
eth_env_set_enetaddr() in env/common.c to call it instead of env_set(),
but never added a prototype to any header. This compiles fine when the
caller and callee live in the same translation unit, but env/common.c
fails with:

  env/common.c:103:16: error: implicit declaration of function 'env_set_force'

The function is unconditionally defined (no Kconfig gate) and has
external linkage, so a single prototype next to env_set() in
include/env.h is the natural fix.

Signed-off-by: TP2 BMC patcher <tp2bmc@local>
---
 include/env.h | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/include/env.h b/include/env.h
index 430c4fa94a..8f6f5f1545 100644
--- a/include/env.h
+++ b/include/env.h
@@ -152,6 +152,19 @@ bool env_get_autostart(void);
  */
 int env_set(const char *varname, const char *value);
 
+/**
+ * env_set_force() - set an environment variable, bypassing write protection
+ *
+ * Like env_set(), but uses H_FORCE so that variables marked read-only in
+ * env_flags can still be written. Used by eth_env_set_enetaddr() to set
+ * MAC address variables that the platform marks as read-only.
+ *
+ * @varname: Variable to adjust
+ * @value: Value to set, or NULL/"" to delete the variable
+ * Return: 0 if OK, 1 on error
+ */
+int env_set_force(const char *varname, const char *value);
+
 /**
  * env_get_ulong() - Return an environment variable as an integer value
  *
