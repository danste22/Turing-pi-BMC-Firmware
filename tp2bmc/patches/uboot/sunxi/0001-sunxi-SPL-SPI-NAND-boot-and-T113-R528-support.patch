+	fel_stash.lr &= ~0xFFFF;
+	fel_stash.lr |= 0x0020;
+
+	debug("Entering FEL sp=%x, lr=%x\n", fel_stash.sp, fel_stash.lr);
+	return_to_fel(fel_stash.sp, fel_stash.lr);
+}
