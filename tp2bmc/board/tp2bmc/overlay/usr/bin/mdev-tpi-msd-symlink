#!/bin/sh
# BusyBox mdev: stable symlinks for Turing Pi 2 node MSD (#225).
# Only USB Mass Storage (bInterfaceClass 08) on internal hub ports 1-1.1..1-1.4.

[ "${SUBSYSTEM:-}" = block ] || exit 0

case "${MDEV:-}" in
sd[a-z]) ;;
*) exit 0 ;;
esac

dev=$(readlink -f "/sys/class/block/${MDEV}/device" 2>/dev/null) || exit 0

# Observed topology: node N on internal root hub port 1-1.N under usb1.
case "$dev" in
*/usb1/*) ;;
*) exit 0 ;;
esac

# Require /1-1.N/ or /1-1.N: so 1-1.10 is not treated as node 1.
n=
case "$dev" in
*/1-1.4/* | */1-1.4:*) n=4 ;;
*/1-1.3/* | */1-1.3:*) n=3 ;;
*/1-1.2/* | */1-1.2:*) n=2 ;;
*/1-1.1/* | */1-1.1:*) n=1 ;;
*) exit 0 ;;
esac

# UMS only (excludes Rockusb/ff, ACM, RNDIS, etc.).
cur=$dev
ums=0
while [ -n "$cur" ] && [ "$cur" != "/" ]; do
	if [ -r "${cur}/bInterfaceClass" ]; then
		ic=$(tr -d ' \n' <"${cur}/bInterfaceClass" 2>/dev/null)
		case "$ic" in
		08|0x08|0X08) ums=1 ;;
		esac
		[ "$ums" = 1 ] && break
	fi
	cur=${cur%/*}
done
[ "$ums" = 1 ] || exit 0

dir=/dev/disk/by-tpi
mkdir -p "$dir"

case "${ACTION:-}" in
add|change) ln -sf "/dev/${MDEV}" "${dir}/node${n}" ;;
remove) rm -f "${dir}/node${n}" ;;
esac

exit 0
