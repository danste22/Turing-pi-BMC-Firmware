#!/bin/sh
# BusyBox mdev: stable symlinks for Turing Pi 2 node MSD (#225).
# Whole-disk sd[a-z] on internal hub ports 1-1.N (usb1) or 2-1.N (usb2).
# Includes RockUSB (ff) and standard UMS (08) on those ports — not other USB buses.

[ "${SUBSYSTEM:-}" = block ] || exit 0

case "${MDEV:-}" in
sd[a-z]) ;;
*) exit 0 ;;
esac

dir=/dev/disk/by-tpi

# RockUSB teardown often skips mdev remove; drop symlinks whose block device is gone.
cleanup_stale_by_tpi_links() {
	for n in 1 2 3 4; do
		link="${dir}/node${n}"
		[ -L "$link" ] || continue
		target=$(readlink "$link" 2>/dev/null) || continue
		bname=${target#/dev/}
		[ -n "$bname" ] || continue
		[ -d "/sys/block/${bname}" ] || rm -f "$link"
	done
}

# On remove, sysfs for the block device is often gone; unlink by target name.
case "${ACTION:-}" in
remove)
	for n in 1 2 3 4; do
		link="${dir}/node${n}"
		[ -L "$link" ] || continue
		target=$(readlink "$link" 2>/dev/null) || continue
		[ "$target" = "/dev/${MDEV}" ] && rm -f "$link"
	done
	cleanup_stale_by_tpi_links
	exit 0
	;;
esac

cleanup_stale_by_tpi_links

dev=$(readlink -f "/sys/class/block/${MDEV}/device" 2>/dev/null) || exit 0

# Internal hub: node N on root hub port 1.N — Linux names the path either
# usb1/1-1/1-1.N (some boots / PHY) or usb2/2-1/2-1.N (EHCI on this BMC).
case "$dev" in
*/usb1/* | */usb2/*) ;;
*) exit 0 ;;
esac

# Require /[12]-1.N/ or /[12]-1.N: so *-1.10 is not treated as node 1.
n=
case "$dev" in
*/1-1.4/* | */1-1.4:* | */2-1.4/* | */2-1.4:*) n=4 ;;
*/1-1.3/* | */1-1.3:* | */2-1.3/* | */2-1.3:*) n=3 ;;
*/1-1.2/* | */1-1.2:* | */2-1.2/* | */2-1.2:*) n=2 ;;
*/1-1.1/* | */1-1.1:* | */2-1.1/* | */2-1.1:*) n=1 ;;
*) exit 0 ;;
esac

mkdir -p "$dir"

case "${ACTION:-}" in
add|change) ln -sf "/dev/${MDEV}" "${dir}/node${n}" ;;
esac

exit 0
